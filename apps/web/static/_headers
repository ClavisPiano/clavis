# Applied by Workers Static Assets. The script/style/img CSP lives in a <meta> tag that SvelteKit
# generates with script hashes (see kit.csp in vite.config.ts), because the static build contains
# an inline bootstrap script. This header carries the directives a meta tag cannot (frame-ancestors).
# No COOP/COEP: the app does not use SharedArrayBuffer.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), midi=(self), camera=()

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/service-worker.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
