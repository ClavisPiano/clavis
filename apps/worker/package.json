{
  "name": "@clavis/worker",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @clavis/web build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:ci": "wrangler d1 migrations apply clavis --remote && wrangler deploy --var VERSION:${WORKERS_CI_COMMIT_SHA:-dev}",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clavis/core": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "wrangler": "4.149.0"
  }
}
