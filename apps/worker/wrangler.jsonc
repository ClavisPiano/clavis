{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clavis",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "VERSION": "dev",
  },
  // SESSION_SECRET is a secret, never put it here: `wrangler secret put SESSION_SECRET`.
  "durable_objects": {
    "bindings": [{ "name": "USER_EVENTS", "class_name": "UserEvents" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserEvents"] }],
  "observability": { "enabled": true },
}
