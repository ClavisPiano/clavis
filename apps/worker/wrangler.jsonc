{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clavis",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "VERSION": "dev",
    // WebAuthn relying party. RP_ID is the bare host, EXPECTED_ORIGIN the exact origin the app is
    // served from (checked on every auth POST). Defaults suit `wrangler dev`; change both to the
    // workers.dev host before the first production deploy, or passkeys will not verify.
    "RP_ID": "localhost",
    "EXPECTED_ORIGIN": "http://localhost:8787",
    // Web Push (practice cue). The public key is not secret; VAPID_PRIVATE_KEY is: see docs/deploy.md
    // for key generation. Leave the public key empty until keys exist (cues are then disabled).
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "mailto:admin@example.invalid",
  },
  // Practice cue: check every 15 minutes which reminders are due (see push/due.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Accounts and passkeys. Create the database once, then paste its id below:
  //   pnpm --filter @clavis/worker exec wrangler d1 create clavis
  // Apply migrations with `wrangler d1 migrations apply clavis --remote` (see docs/deploy.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clavis",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // SESSION_SECRET is a secret, never put it here: `wrangler secret put SESSION_SECRET`.
  "durable_objects": {
    "bindings": [{ "name": "USER_EVENTS", "class_name": "UserEvents" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserEvents"] }],
  "observability": { "enabled": true },
}
